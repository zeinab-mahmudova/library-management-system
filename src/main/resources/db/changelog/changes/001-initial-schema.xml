<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://liquibase.org"
        xmlns:xsi="http://w3.org"
        xsi:schemaLocation="http://liquibase.org
        http://liquibase.org/dbchangelog-4.20.xsd">

    <changeSet id="1" author="library-system">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="authors">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="members">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="library-system">
        <createTable tableName="books">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="isbn" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="publication_year" type="INT"/>
            <column name="price" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="discount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="author_id" type="BIGINT"/>
            <column name="borrowed_by_member_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="books" baseColumnNames="author_id"
                                 constraintName="fk_books_author"
                                 referencedTableName="authors" referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="books" baseColumnNames="borrowed_by_member_id"
                                 constraintName="fk_books_member"
                                 referencedTableName="members" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="3" author="library-system">
        <createTable tableName="orders">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_date" type="TIMESTAMP"/>
            <column name="status" type="VARCHAR(50)"/>
            <column name="member_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="member_id"
                                 constraintName="fk_orders_member"
                                 referencedTableName="members" referencedColumnNames="id"/>

        <createTable tableName="order_items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="quantity" type="INT"/>
            <column name="price" type="DECIMAL(19,2)"/>
            <column name="order_id" type="BIGINT"/>
            <column name="book_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="order_items" baseColumnNames="order_id"
                                 constraintName="fk_items_order"
                                 referencedTableName="orders" referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="order_items" baseColumnNames="book_id"
                                 constraintName="fk_items_book"
                                 referencedTableName="books" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
